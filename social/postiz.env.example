# =============================================================
# POSTIZ — configuración
# Copiar como  postiz.env  y rellenar
# =============================================================

# ── Núcleo (obligatorios) ────────────────────────────────────
MAIN_URL="http://localhost:4007"
FRONTEND_URL="http://localhost:4007"
NEXT_PUBLIC_BACKEND_URL="http://localhost:4007/api"
BACKEND_INTERNAL_URL="http://localhost:3000"
JWT_SECRET="cambia-esto-por-una-cadena-larga-aleatoria"

DATABASE_URL="postgresql://postiz-local:postiz-local-pwd@postiz-postgres:5432/postiz-db-local"
REDIS_URL="redis://postiz-redis:6379"

IS_GENERAL="true"
DISABLE_REGISTRATION="false"
STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="/uploads"
NEXT_PUBLIC_UPLOAD_DIRECTORY=""
API_LIMIT="90"

# ── OpenAI (para autogenerar copies y portadas) ──────────────
OPENAI_API_KEY=""

# ── OAuth de cada red social ─────────────────────────────────
# Solo rellenas las que vayas a usar. Cada app se crea en su
# portal de developers y se apunta la Callback URL:
#   http://localhost:4007/integrations/social/<red>

# X / Twitter    → https://developer.twitter.com
X_API_KEY=""
X_API_SECRET=""

# LinkedIn       → https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Facebook + Instagram + Threads (mismo Meta App)
#   https://developers.facebook.com/apps/
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""

# YouTube        → https://console.cloud.google.com (OAuth)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# TikTok         → https://developers.tiktok.com
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""

# Pinterest      → https://developers.pinterest.com
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""

# Reddit         → https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Discord        → https://discord.com/developers/applications
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""

# Slack          → https://api.slack.com/apps
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""

# Mastodon (instancia propia)
MASTODON_URL=""
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# Dribbble
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
